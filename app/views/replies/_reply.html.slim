= turbo_frame_tag dom_id(reply) do
  .d-flex.align-items-start.gap-2
    i.fa-solid.fa-reply.text-secondary.pt-1[aria-hidden= "true"]
    .reply.card.mb-2.flex-grow-1
      .card-body.py-2
        .d-flex.justify-content-between.align-items-baseline
          strong.me-2
            i.fa-solid.fa-user
            = reply.user.display_name
          .d-flex.align-items-center.gap-2
            small.text-muted = reply.date_format
            - if user_signed_in? && reply.user_id == current_user.id
              .dropdown style= "cursor: pointer"
                i.fa-solid.fa-gear[
                  data-bs-toggle= "dropdown" style= "cursor: pointer"
                ]
                .dropdown-menu.dropdown-menu-end
                  = link_to '<i class= "fa fa-pencil"></i>Edit'.html_safe,
                    edit_tweet_reply_path(reply.parent, reply),
                    class: "dropdown-item"
                  = button_to '<i class= "fa fa-trash"></i>Delete'.html_safe,
                    tweet_reply_path(reply.parent, reply), method: :delete,
                    class: "dropdown-item",
                    data: { turbo_confirm: "Are you sure?" }
        .mt-1
          = simple_format(reply.content, { class: "mb-0" })
