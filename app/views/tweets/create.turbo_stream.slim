- if @form.model.persisted?
  = turbo_stream.prepend "tweets" do
    = render partial: "tweet", locals: { tweet: @form.model.decorate }

  = turbo_stream.replace "tweet-form" do
    = render partial: "form", locals: { form: TweetForm.new(current_user.tweets.build) }
- else
  = turbo_stream.replace "tweet-form" do
    = render partial: "form", locals: { form: @form }


