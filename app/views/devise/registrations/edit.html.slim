section[class= "w-50 d-flex flex-column gap-2"]
  h2 Edit #{resource_name.to_s.humanize}

  = form_for(@form, as: resource_name,
    url: registration_path(resource_name),
    html: { method: :put }) do |f|
    = render "devise/shared/error_messages", resource: @form

    .form-group
      = f.label :display_name
      = f.text_field :display_name, autofocus: true, class: "form-control"

    .form-group
      = f.label :username
      = f.text_field :username, class: "form-control"

    - if devise_mapping.confirmable? && resource.pending_reconfirmation?
      div Currently waiting confirmation for: #{resource.unconfirmed_email}

    .form-group
      = f.label :password
      br
      i leave blank if you don't want to change it
      = f.password_field :password, class: "form-control"
      - if @minimum_password_length
        em #{@minimum_password_length} characters minimum

    .form-group
      = f.label :password_confirmation
      br
      = f.password_field :password_confirmation, class: "form-control"

    .form-group
      = f.label :current_password
      br
      i we need your current password to confirm your changes
      br
      = f.password_field :current_password, class: "form-control"

    .actions.pt-2.pb-2
      = f.submit "Update"

  h3 Cancel my account

  div
    = button_to "Cancel my account", registration_path(resource_name),
      data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" },
      method: :delete, class: "btn btn-danger"

  = link_to "Back", :back
